# ---------------------------------------------------------------------------
# Awesome_API application configuration.
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Application
APP_NAME=Awesome_API
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins, e.g. https://example.com
CORS_ORIGINS=

# Logging
LOG_LEVEL=INFO
# Log format: "json" (default) or "text"
LOG_FORMAT=json

# DNS
# Comma-separated nameservers (IPv4/IPv6). Empty = use system resolvers.
DNS_NAMESERVERS=1.1.1.1,1.0.0.1
DNS_TIMEOUT=3
DNS_LIFETIME=5

# Caching
CACHE_ENABLED=true
REDIS_URL=redis://redis:6379/0
DNS_CACHE_TTL=300
WHOIS_CACHE_TTL=3600
IP_LOOKUP_CACHE_TTL=3600
CACHE_MAX_ENTRIES=10000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXPENSIVE_REQUESTS=20
RATE_LIMIT_NETWORK_REQUESTS=15
RATE_LIMIT_SECURITY_REQUESTS=30
RATE_LIMIT_MAX_KEYS=100000

# Webpage metadata extraction
WEBPAGE_TIMEOUT=10
WEBPAGE_CONNECT_TIMEOUT=5
WEBPAGE_READ_TIMEOUT=8
WEBPAGE_MAX_RESPONSE_SIZE=5242880
WEBPAGE_MAX_REDIRECTS=5
WEBPAGE_USER_AGENT=Awesome_API/1.0 (+https://example.com/bot)

# Outbound HTTP timeout (seconds) for generic HTTP lookups
HTTP_TIMEOUT=10

# Providers
# GeoIP provider: "none" (local validation only) or "ip-api" (free, no key)
GEOIP_PROVIDER=none
GEOIP_API_KEY=

# WHOIS / RDAP timeouts
WHOIS_TIMEOUT=10
RDAP_TIMEOUT=10

# Observability
# Expose /metrics endpoint
METRICS_ENABLED=false
METRICS_PORT=9090

# Request/resource limits
MAX_REQUEST_BODY_BYTES=12000000
MAX_JSON_BODY_BYTES=10500000
MAX_URL_LENGTH=8192
MAX_RESPONSE_BODY_BYTES=10000000
MAX_JSON_DEPTH=100
MAX_JSON_NODES=100000
MAX_PARSER_NODES=100000
MAX_IMAGE_BYTES=7500000
MAX_IMAGE_PIXELS=40000000
MAX_UPSTREAM_RESPONSE_BYTES=5242880

# Image processing (conversion / resize / PDF / background removal)
IMAGE_WIDTH_MAX=24000
IMAGE_CANVAS_MAX_DIMENSION=8192
IMAGE_TARGET_SIZE_MIN_KB=8
IMAGE_TARGET_SIZE_MAX_KB=4000
IMAGE_MAX_OUTPUT_BYTES=15000000
IMAGE_MAX_PDF_PAGES=50
IMAGE_MAX_PDF_DPI=300
IMAGE_MAX_RASTERIZE_BYTES=40000000
IMAGE_MAX_CONCURRENT=2
IMAGE_TIMEOUT_SECONDS=60
# Enable AI background removal. Requires: pip install -e ".[image-ai]"
IMAGE_BACKGROUND_REMOVAL_ENABLED=false
IMAGE_REMBG_MODEL=u2net

# Provider API keys (never commit real ones)
PROVIDER_API_KEY=

# Browser-based Web Intelligence APIs
ACCESSIBILITY_AUDIT_ENABLED=true
ACCESSIBILITY_AUDIT_MAX_ELEMENTS=600
WEB_VITALS_ENABLED=true
WEB_VITALS_MEASUREMENT_MS=500
WEB_VITALS_MAX_INTERACTIONS=5
SCREENSHOT_ENABLED=true
SCREENSHOT_DEFAULT_WIDTH=1440
SCREENSHOT_DEFAULT_HEIGHT=900
SCREENSHOT_MAX_WIDTH=2560
SCREENSHOT_MAX_HEIGHT=1600
SCREENSHOT_MAX_BYTES=8000000
SCREENSHOT_MAX_FULL_PAGE_HEIGHT=10000
SCREENSHOT_TIMEOUT_MS=10000
SCREENSHOT_MAX_CONCURRENT=2
API_DISCOVERY_ENABLED=true
API_DISCOVERY_MAX_ENDPOINTS=100
API_DISCOVERY_MAX_PROBES=6
API_DISCOVERY_MAX_REQUESTS=100
